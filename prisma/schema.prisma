// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A registered Saptapadi member (auth-lite credentials account).
model Member {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  city         String?
  profession   String?
  height       String?
  about        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())

  @@index([email])
}

/// A "Send Interest" action from the visitor to a matrimony profile.
/// `owner` is the member email when signed in, else "guest".
model Interest {
  id          String   @id @default(cuid())
  profileId   String
  profileName String
  note        String?
  owner       String   @default("guest")
  status      String   @default("sent")
  createdAt   DateTime @default(now())

  @@unique([profileId, owner])
  @@index([owner, createdAt])
}

/// A membership plan order started from the pricing section.
/// `owner` is the member email when signed in, else "guest".
model MembershipOrder {
  id        String   @id @default(cuid())
  plan      String
  fullName  String
  email     String
  phone     String
  city      String
  amount    String
  owner     String   @default("guest")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([owner, createdAt])
}

/// Persisted concierge chat transcript (one row per message).
model ConciergeMessage {
  id        String   @id @default(cuid())
  session   String
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([session, createdAt])
}

/// Matchmaker desk curation for a catalogue profile — featured pinning,
/// verified override and an internal note. One row per curated profile.
model ProfileCuration {
  profileId String   @id
  featured  Boolean  @default(false)
  verified  Boolean  @default(false)
  note      String   @default("")
  updatedAt DateTime @updatedAt
}

/// A member's saved search — a named, re-appliable filter set.
/// `owner` is the member email; guests keep saved searches in localStorage.
/// `lastCount` baselines the match count so "new matches since saved"
/// notifications can fire exactly once per change when `notify` is on.
model SavedSearch {
  id        String   @id @default(cuid())
  owner     String
  name      String
  queryJson String
  notify    Boolean  @default(true)
  lastCount Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([owner, name])
  @@index([owner, createdAt])
}

/// An in-app notification for a member (interest decisions, order updates…).
/// `owner` is the member email; guest visitors don't get notifications.
/// `refId` links the notification to its source record (e.g. an interest id)
/// so lifecycle syncs stay idempotent.
model Notification {
  id        String   @id @default(cuid())
  owner     String
  type      String   @default("info")
  title     String
  body      String   @default("")
  read      Boolean  @default(false)
  refId     String?
  createdAt DateTime @default(now())

  @@index([owner, createdAt])
  @@index([refId])
}
